{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    // Emits CommonJS (package.json has no "type": "module") and allows
    // require() of ESM-only dependencies such as inquirer and commander.
    "module": "node20",
    "types": ["node"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
